node_modules/
dist/
release/

# Editor/agent scratch state, not part of the app.
.freebuff/
.shots/
.probe-*.mjs
# Captured output from a local release run (`cmd /c release.bat > .release-run.out`).
# release.bat commits with `git add -A`, so this has to be ignored or the run logs
# itself into the release commit and then fails its own post-commit clean-tree check.
.release-run.out
# The CDP-driven UI harness. Promote it into tests/ behind an npm script before
# committing it; until then it stays local scratch.
.verify-ui.mjs
resources/bin/*.exe
resources/bin/*.dll
# Fetched and checksummed by `npm run prepare:binaries` (~220 MB).
resources/models/
resources/ort/
.bin-scratch/
*.log
.DS_Store
